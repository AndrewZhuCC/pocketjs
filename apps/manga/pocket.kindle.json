{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "app.anzhi.manga-kindle",
  "name": "pocketjs-manga-kindle",
  "title": "漫画 (Suwayomi)",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/manga/main.tsx",
    "output": "manga-kindle-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [309, 412],
        "presentation": "native"
      }
    }
  }
}
